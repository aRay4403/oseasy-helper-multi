# ============================================================
#  噢易教室助手 · 多教室配置（示例）
# ============================================================
#
#  用法：把本文件复制成 classrooms.conf，然后改成你自己的教室。
#
#      copy classrooms.conf.example classrooms.conf
#
#  格式：一行一个教室
#
#      教室名 = 教师机IP [, 本机IP] [, key=值 ...]
#
#  规则：
#    * 以 # 开头的是注释，随便加
#    * 教室名支持简写：选教室时输入任意一段字符就能匹配到
#    * 逗号后面直接写一个裸 IP，等于 local-ip=（本机固定 IP）
#    * 逗号后面写 key=值，见下面「可用的配置项」
#
#  可用的配置项：
#
#      local-ip=10.140.17.234  这间教室本机网卡该用的 IP。
#                              教室网口如果是「端口 + IP 绑定」的静态地址，
#                              换教室必须跟着改，否则连不上教师机。
#                              不写就问你要；写 local-ip=ask 表示每次都问。
#
#      gateway=10.140.17.1     网关，默认取「教师机网段.1」
#
#      manual-ip=1             这间教室的教师机 IP 每次不一样，选到时让你手填
#                              （只影响 选教室.bat / switch.py）
#
#      ip-prefix=10.144.61.    配合 manual-ip：限定只能填这个网段里的地址
#
#      mcast-group=229.1.1.1   固定视频组播组。一般不用写 —— 脚本会自动探测
#                              （各教室不一样，按公式算经常是错的）
#
#      http-port=17778         自研模式本机播放地址端口
#      udp-port=7778           视频组播端口
#
#  示例：
#      实验楼A301 = 10.115.4.137
#      实验楼B105 = 10.115.4.200, local-ip=10.115.4.88
#      综合楼机房3 = 10.115.8.11, 10.115.1.54
#
# ============================================================


# ↓↓↓ 在下面填你自己的教室 ↓↓↓

# 普通教室：教师机 IP 固定，本机 IP 也固定（静态 IP 的机房）
5-213 = 10.140.16.170, local-ip=10.140.16.234
5-214 = 10.140.17.170, local-ip=10.140.17.234

# 本机是 DHCP 自动获取的教室：不写 local-ip，本机 IP 每次自动探测
# 5-215 = 10.140.18.170

# 教师机 IP 每节课都变、但网段固定的教室：选它时手填（回车可自动扫网段）
# 频道12 = 10.144.61.65, manual-ip=1, ip-prefix=10.144.61., local-ip=ask
